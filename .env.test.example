# RLS testleri için gerekli ortam değişkenleri
# Bu dosyayı .env.test adıyla kopyalayıp doldurun.
# NOT: Bu bilgileri git'e commit ETMEYİN!

# Local Supabase bağlantısı (npx supabase start çıktısından)
SUPABASE_LOCAL_URL=http://localhost:54321
SUPABASE_LOCAL_ANON_KEY=your-local-anon-key-from-supabase-start
SUPABASE_LOCAL_SERVICE_ROLE_KEY=your-local-service-role-key-from-supabase-start

# Test kullanıcıları (otomatik oluşturulur/silinir)
TEST_USER_A_EMAIL=user_a@test.clinicalpsm.com
TEST_USER_B_EMAIL=user_b@test.clinicalpsm.com
TEST_USER_PASSWORD=TestPassword!123
