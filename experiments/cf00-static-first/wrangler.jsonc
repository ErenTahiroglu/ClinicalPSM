{
  "name": "cf00-static-first-poc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "cf00-poc-local", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8790",
    "BETTER_AUTH_SECRET": "poc-only-secret-0123456789abcdef0123456789abcdef",
    "WEBHOOK_SECRET": "poc-webhook-secret",
    "ALLOW_TEST_ENDPOINTS": "1",
    "PASSWORD_MODE": "default"
  }
}
