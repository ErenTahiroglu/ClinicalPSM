# ClinicalPSM Environment Variables Template
# Copy this file to .env.local and fill in real values.
# DO NOT commit actual secrets to version control.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Required for Authentication and Database)
# These values can be found in your Supabase project settings under API.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Polar.sh (Payments — Add when enabling paid plans in v0.2)
# Integration with Polar.sh for subscriptions and billing.
POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret
# Server-only product IDs (no NEXT_PUBLIC_ prefix — never exposed to browser)
POLAR_PLUS_PRODUCT_ID=your_polar_plus_product_id
POLAR_PRO_PRODUCT_ID=your_polar_pro_product_id
