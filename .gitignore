# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
/.next/
/out/
/build

# Testing (Vitest & Playwright)
/coverage
/playwright-report/
/test-results/
/blob-report/

# OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment Files - SECRETS MUST NEVER BE COMMITTED
.env*
# Except example files
!.env*.example

# Vercel Configuration
.vercel

# Debug & Log Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Misc
*.pem
*.tsbuildinfo
next-env.d.ts

# Supabase
supabase/.branches/
supabase/.temp/
/dist/
.vinext/
.cloudflare/
/.wrangler/
.dev.vars
/experiments/**/node_modules/
/experiments/**/.wrangler/
/experiments/**/dist-prod/
/experiments/cf01-static-site/public/

# Dev toolchain (DEVTOOLS-00): generated graphs, indexes and scanner reports stay local
/graphify-out/
/.cbm/
/.gitleaks-report*
/.tools/
/experiments/**/wrangler.deploy.local.jsonc
.gates-report.json
