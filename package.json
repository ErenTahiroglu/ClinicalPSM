{
  "name": "clinicalpsm-root",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.0.0",
    "dotenv": "^17.4.1",
    "shadcn": "^4.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "scripts": {
    "dev": "cd clinicalpsm && next dev",
    "build": "cd clinicalpsm && next build",
    "start": "cd clinicalpsm && next start",
    "lint": "cd clinicalpsm && next lint",
    "test": "cd clinicalpsm && vitest run --exclude 'src/lib/supabase/__tests__/**'",
    "test:watch": "cd clinicalpsm && vitest",
    "test:coverage": "cd clinicalpsm && vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:install": "playwright install",
    "e2e:report": "playwright show-report"
  }
}
